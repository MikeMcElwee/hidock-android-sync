# hidock-android-sync configuration
# Copy this file to ~/.config/hidock-sync/config and edit as needed.
# Both run_sync.sh and hidock_sync.py source these values.

# rclone remote name for Google Drive (whatever you set during `rclone config`)
DRIVE_REMOTE=gdrive

# Path inside the Drive where day-folders will be created
DRIVE_BASE=HiDock/Documents

# Local working directory for in-flight files (deleted after upload)
STAGING_DIR=/sdcard/Download/hidock_staging

# Log directory (JOB_FIRE ticks in cron_ticks.log + per-run sync.log)
LOG_DIR=$HOME/.config/hidock-sync

# JobScheduler period in minutes (consumed by setup-jobscheduler.sh).
# Android JobScheduler typically enforces a 15-minute minimum; shorter
# values are clamped to 900000 ms with a warning.
JOB_INTERVAL_MIN=30

# Deprecated alias of JOB_INTERVAL_MIN; still read if JOB_INTERVAL_MIN is unset.
# Only used by the deprecated setup-cron.sh path.
CRON_INTERVAL_MIN=30

# ffmpeg AAC bitrate for the .m4a output
M4A_BITRATE=64k

# Where hidock-next was cloned (provides the Jensen protocol implementation)
HIDOCK_NEXT_DIR=$HOME/hidock-android-sync/hidock-next
